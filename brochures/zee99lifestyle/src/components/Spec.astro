---
/**
 * 04 — specification.
 *
 * Set as a table rather than prose because a list of named brands is more
 * convincing as data than as a sentence. Every row is verbatim from
 * docs/facts.md; nothing is characterised or ranked.
 */
import { spec } from '../lib/content';
---

<section id="spec" data-section="spec" data-no="04" data-name="Specification" data-tone="light" class="section spec">
  <div class="wrap">
    <header class="shead">
      <div class="shead__meta">
        <span class="shead__no">04</span>
        <span class="shead__name">Specification</span>
      </div>
      <h2 class="t-h2 spec__h" id="spec-h">{spec.head}</h2>
      <p class="t-lead prose">{spec.lead}</p>
    </header>

    <div class="spec__table" role="table" aria-label="Fittings specification">
      <div class="spec__head" role="row">
        <span role="columnheader" class="label">Item</span>
        <span role="columnheader" class="label">Specification</span>
        <span role="columnheader" class="label">Brands</span>
      </div>
      {spec.rows.map((r) => (
        <div class="spec__row" role="row">
          <span class="spec__item" role="cell">{r.item}</span>
          <span class="spec__detail" role="cell">{r.detail}</span>
          <span class="spec__brands" role="cell">
            {r.brands.map((b, i) => (
              <>
                <span class="spec__brand">{b}</span>
                {i < r.brands.length - 1 && <span class="spec__sep" aria-hidden="true">·</span>}
              </>
            ))}
          </span>
        </div>
      ))}
    </div>

    <p class="spec__close">{spec.close}</p>
  </div>
</section>

<style>
  .spec__h { max-width: 16ch; }

  .spec__table { margin-top: var(--s7); border-top: 1px solid var(--line-strong); }

  .spec__head { display: none; }
  @media (min-width: 800px) {
    .spec__head {
      display: grid;
      grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.3fr) minmax(0, 1.1fr);
      gap: var(--s5);
      padding: var(--s3) 0;
      border-bottom: 1px solid var(--line);
    }
  }

  .spec__row {
    display: grid;
    gap: var(--s1);
    padding: var(--s5) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .spec__row {
      grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.3fr) minmax(0, 1.1fr);
      gap: var(--s5);
      align-items: baseline;
      padding: var(--s5) 0;
    }
  }

  .spec__item {
    font-family: var(--font-display);
    font-size: var(--t-body);
    font-weight: 540;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .spec__detail {
    font-family: var(--font-text);
    font-size: var(--t-small);
    color: var(--ink-2);
    line-height: 1.45;
  }
  .spec__brands {
    font-family: var(--font-display);
    font-size: var(--t-small);
    color: var(--ink-3);
    display: flex; flex-wrap: wrap; gap: 0 var(--s2);
    align-items: baseline;
  }
  .spec__sep { color: var(--ink-4); }

  .spec__close {
    margin-top: var(--s6);
    font-family: var(--font-display);
    font-size: var(--t-small);
    color: var(--ink-2);
    max-width: 42ch;
  }
</style>
