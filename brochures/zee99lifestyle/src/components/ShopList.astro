---
/**
 * Every shop on a floor, with what it actually costs.
 *
 * Until now the commercial section ran five phone screens and contained no
 * shop price at all — every rupee figure in it was a *rate*. A buyer was left
 * to multiply 380 by 55,000 in their head while every apartment on the page
 * got a real number and a schedule. Worse, the only route to a unit's figures
 * was tapping a marker on the plate, so with scripting off all twenty-three
 * were unreachable.
 *
 * This is plain markup: it is correct before a single byte of JavaScript runs,
 * and the plate stays what it is good at — showing which shop is *where*.
 */
import { rs, short, num, STATUS_LABEL, type ComUnit } from '../lib/inventory';

interface Props { units: ComUnit[]; label: string; note?: string }
const { units, label, note } = Astro.props;

const rows = units.map((u) => ({
  ...u,
  no: u.type === 'Kiosk' ? 'K' : u.id.replace(/^[GL]/, '').padStart(2, '0'),
}));
---

<details class="sl" data-shoplist>
  <summary class="sl__head">
    <span class="label sl__label">{label}</span>
    <span class="sl__note">{note}</span>
    <span class="sl__i" aria-hidden="true"></span>
  </summary>

  <ol class="sl__rows">
    {rows.map((u) => (
      <li class="sl__row" data-status={u.status} data-unit-row={u.id}>
        <span class="sl__no num">{u.no}</span>
        <span class="sl__size num">{num(u.sqft)} <i>sq ft</i></span>
        <span class="sl__price num">{rs(u.price)}</span>
        <span class="sl__short num">{short(u.price)}</span>
        <span class="sl__pay num">
          <b>{rs(u.plan.monthly)}</b> a month · {rs(u.plan.down)} down
        </span>
        <span class="sl__status">{STATUS_LABEL[u.status]}</span>
      </li>
    ))}
  </ol>
</details>

<style>
  /* Folded shut. Twenty-three shops printed open is four screens of figures in
     a section whose job is to show *where* each shop is; the plate above does
     that, and this answers the question it raises. */
  .sl { margin-top: var(--s7); border-top: 1px solid var(--line-strong); }
  .sl__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'label icon' 'note icon';
    gap: 3px var(--s4);
    padding: var(--s4) 0;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    align-items: center;
  }
  .sl__label { grid-area: label; }
  .sl__note { grid-area: note; }
  .sl__i { grid-area: icon; }
  .sl__head::-webkit-details-marker { display: none; }
  .sl__label { color: var(--ink); font-size: var(--t-fine); }
  .sl__note { font-family: var(--font-display); font-size: var(--t-fine); color: var(--ink-3); }
  .sl__i { width: 13px; height: 13px; position: relative; }
  .sl__i::before, .sl__i::after {
    content: ''; position: absolute; background: var(--ink-3);
    transition: transform var(--dur-mid) var(--ease-out), opacity var(--dur-mid) var(--ease-out);
  }
  .sl__i::before { inset: 6px 0 6px 0; height: 1px; }
  .sl__i::after { inset: 0 6px 0 6px; width: 1px; }
  .sl[open] .sl__i::after { transform: scaleY(0); opacity: 0; }

  .sl__rows { list-style: none; margin: 0 0 var(--s5); padding: 0; border-top: 1px solid var(--line); }

  /* Phone: two lines. Unit and size lead, the price is the thing on the right,
     the schedule and the state sit under them. */
  .sl__row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    grid-template-areas:
      'no size price'
      'no pay  short'
      'no status status';
    column-gap: var(--s3);
    row-gap: 2px;
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .sl__no {
    grid-area: no;
    font-size: var(--t-fine); font-weight: 620; color: var(--ink-3);
  }
  .sl__size { grid-area: size; font-size: var(--t-small); font-weight: 500; color: var(--ink); }
  .sl__size i { font-style: normal; color: var(--ink-3); font-size: var(--t-fine); }
  .sl__price {
    grid-area: price; text-align: right; white-space: nowrap;
    font-size: var(--t-small); font-weight: 540; color: var(--ink);
  }
  .sl__short { grid-area: short; text-align: right; font-size: var(--t-fine); color: var(--ink-3); }
  .sl__pay { grid-area: pay; font-size: var(--t-fine); color: var(--ink-3); }
  .sl__pay b { font-weight: 560; color: var(--ink-2); }
  .sl__status {
    grid-area: status;
    font-family: var(--font-display); font-size: var(--t-fine);
    letter-spacing: var(--tr-label); text-transform: uppercase;
    color: var(--ink-4); margin-top: var(--s1);
  }
  /* one lit state, three quiet — the same rule the plate and the inventory use */
  .sl__row[data-status='available'] .sl__status { color: var(--signal-deep); font-weight: 620; }
  .sl__row[data-status='sold'] .sl__no,
  .sl__row[data-status='sold'] .sl__size,
  .sl__row[data-status='sold'] .sl__price { color: var(--ink-4); }
  .sl__row[data-status='sold'] .sl__pay { color: var(--ink-4); }

  /* selected from the plate above */
  .sl__row[data-on] { background: var(--paper-panel); box-shadow: -0.75rem 0 0 var(--paper-panel), 0.75rem 0 0 var(--paper-panel); }

  @media (min-width: 720px) {
    .sl__row {
      grid-template-columns: 2rem 7rem minmax(0, 1fr) auto 7rem;
      grid-template-areas: 'no size pay price status';
      align-items: baseline;
      column-gap: var(--s5);
      padding: var(--s3) 0;
    }
    .sl__short { display: none; }
    .sl__status { text-align: right; margin-top: 0; }
    .sl__price { font-size: var(--t-body); font-weight: 500; }
  }
</style>
