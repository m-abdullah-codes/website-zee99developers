---
/**
 * 00 — the front cover.
 *
 * The video is the strongest asset in the folder, so nothing is allowed to
 * delay it: the responsive poster paints on the first frame and the video
 * layers in over it only once it can actually play. It never blocks, never
 * carries audio, and is skipped outright on a metered or slow connection.
 *
 * Text arrives after two beats, low and left. Confidence is quiet.
 */
import Picture from './Picture.astro';
import { opening } from '../lib/content';
import { resUnits, comUnits, resTypes, short, possessionMonths } from '../lib/inventory';

/* A cover that names nothing is a cover nobody can act on. "Apartments" first
   appeared at screen 2.2 and the first price at screen 3.6; this stamps both on
   the first frame. Computed, like every other figure on the page. */
const cheapest = Math.min(...resTypes.map((t) => t.price));
const stamp = [
  `${resUnits.length} apartments · ${comUnits.length} shops`,
  `From Rs ${short(cheapest)}`,
  `Possession in ${possessionMonths} months`,
];
---

<section
  id="opening"
  data-section="opening"
  data-no="00"
  data-name="Cover"
  data-tone="deep"
  class="cover"
  aria-label="Cover"
>
  <div class="cover__media">
    <Picture
      src="video-poster"
      portraitSrc="video-poster-portrait"
      alt=""
      sizes="100vw"
      priority
      className="cover__poster"
      fit="cover"
    />
    <!-- No `poster` attribute: it is fetched eagerly even under preload="none",
         and it could never be seen — the element is transparent until the first
         real frame is on screen, and the <Picture> above is already that frame
         at full quality. -->
    <video
      id="coverVideo"
      class="cover__video"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    ></video>
    <div class="cover__scrim" aria-hidden="true"></div>
  </div>

  <div class="cover__body wrap">
    <div class="cover__id">
      <h1 class="cover__title">{opening.title}</h1>
      <p class="cover__place label">{opening.place}</p>
    </div>
    <p class="cover__line" id="coverLine">{opening.line}</p>

    <ul class="cover__stamp">
      {stamp.map((s) => <li class="num">{s}</li>)}
    </ul>
  </div>

  <div class="cover__foot wrap" aria-hidden="true">
    <span class="label cover__hint">{opening.scrollHint}</span>
    <span class="cover__hintline"></span>
  </div>
</section>

<style>
  .cover {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto auto;
    color: var(--on-deep);
    background: var(--deep);
    overflow: clip;
  }

  .cover__media { position: absolute; inset: 0; }
  .cover__media :global(.cover__poster) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    aspect-ratio: auto !important;
  }
  .cover__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }
  .cover__video[data-playing] { opacity: 1; }

  /* The renders are dusk: dark at the edges already. The scrim only has to
     guarantee the type's contrast, not repaint the image. */
  .cover__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, oklch(18% 0.02 260 / 0.82) 0%, oklch(18% 0.02 260 / 0.34) 34%, oklch(18% 0.02 260 / 0.06) 62%),
      linear-gradient(to right, oklch(18% 0.02 260 / 0.42), transparent 55%);
  }

  .cover__body {
    grid-row: 2;
    position: relative;
    padding-bottom: var(--s6);
  }

  .cover__id { display: grid; gap: var(--s3); }

  .cover__title {
    font-family: var(--font-display);
    font-weight: 470;
    font-size: var(--t-h1);
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-mega);
    color: var(--on-deep);
  }
  .cover__place {
    color: oklch(84% 0.012 252);
    letter-spacing: var(--tr-micro);
  }

  .cover__line {
    margin-top: var(--s7);
    max-width: 30ch;
    font-family: var(--font-text);
    font-size: var(--t-lead);
    line-height: 1.36;
    color: oklch(92% 0.010 252);
    text-wrap: balance;

    /* two beats, then it resolves. no movement, only presence. */
    opacity: 0;
    animation: coverline 1400ms var(--ease-out) 1900ms forwards;
  }
  @keyframes coverline { to { opacity: 1; } }

  /* Three facts on one rule, arriving with the line above them. Set in the
     grotesque at label size: a stamp, not a headline. */
  .cover__stamp {
    list-style: none; margin: var(--s6) 0 0; padding: var(--s3) 0 0;
    border-top: 1px solid oklch(80% 0.012 254 / 0.42);
    display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5);
    font-family: var(--font-display);
    font-size: var(--t-fine); font-weight: 500;
    letter-spacing: 0.02em;
    color: oklch(88% 0.012 252);
    max-width: 34rem;

    opacity: 0;
    animation: coverline 1400ms var(--ease-out) 2200ms forwards;
  }

  .cover__foot {
    grid-row: 3;
    padding-bottom: max(var(--s6), env(safe-area-inset-bottom));
    display: flex; align-items: center; gap: var(--s3);
  }
  .cover__hint { color: oklch(74% 0.014 254); }
  .cover__hintline {
    height: 1px; flex: 1; max-width: 5rem;
    background: linear-gradient(to right, oklch(74% 0.014 254), transparent);
  }

  @media (min-width: 900px) {
    .cover__body { padding-bottom: var(--s8); }
    .cover__line { margin-top: var(--s8); font-size: clamp(1.25rem, 1.5vw, 1.6rem); }
    .cover__foot { padding-bottom: var(--s8); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__line, .cover__stamp { opacity: 1; animation: none; }
    .cover__video { transition: none; }
  }
</style>

<script>
  import { asset } from '../lib/asset';
  import { UPRIGHT_PHONE } from '../lib/viewport';

  // The video is ambient. It is allowed to cost nothing: it is not fetched at
  // all until the page is idle, and not at all on a metered, slow, or
  // motion-reduced session. The poster is a real frame from it, so skipping it
  // costs the reader nothing they can name.
  (() => {
    const v = document.getElementById('coverVideo') as HTMLVideoElement | null;
    if (!v) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as any).connection;
    const stingy =
      conn && (conn.saveData || /^(slow-2g|2g|3g)$/.test(conn.effectiveType || ''));
    if (reduced || stingy) return;

    const start = () => {
      // The source is a 5.6MB 1080p file; a phone should never pull it.
      //
      // A phone held upright cannot show 16:9 at all: `object-fit: cover` keeps
      // about a quarter of the frame's width and magnifies it four-fold, so the
      // landscape ladder arrives as mush however many bits it carries. Upright
      // it gets the 9:16 crop instead (~1MB, every pixel of it on screen); the
      // widths below are for phones turned sideways, tablets and desktop.
      const w = innerWidth;
      v.src = asset(
        matchMedia(UPRIGHT_PHONE).matches ? '/video/opening-portrait.mp4'
        : w >= 1100 ? '/video/opening-1080.mp4'
        : w >= 700 ? '/video/opening-720.mp4'
        : '/video/opening-540.mp4'
      );
      v.load();
      v.addEventListener('canplay', () => {
        v.play().then(() => v.setAttribute('data-playing', '')).catch(() => {});
      }, { once: true });
    };

    // wait for idle so the video never competes with the fold
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 2600 });
    else setTimeout(start, 1600);

    // stop decoding once the cover is off screen
    const io = new IntersectionObserver(
      ([e]) => { if (!v.src) return; e.isIntersecting ? v.play().catch(() => {}) : v.pause(); },
      { threshold: 0.05 }
    );
    io.observe(v);
  })();
</script>
